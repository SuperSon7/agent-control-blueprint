{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JobSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_id",
    "project_id",
    "kind",
    "spec_version",
    "goal",
    "acceptance",
    "non_goals",
    "allowed_write_paths",
    "risk_floor",
    "base_sha",
    "environment",
    "budget"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "job_id": {
      "type": "string",
      "pattern": "^job-[a-z0-9-]{1,64}$"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,63}$"
    },
    "kind": {
      "enum": [
        "feature",
        "bugfix",
        "research",
        "architecture",
        "infra_plan",
        "infra_apply"
      ]
    },
    "spec_version": {
      "type": "integer",
      "minimum": 1
    },
    "goal": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "non_goals": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "allowed_write_paths": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "risk_floor": {
      "type": "string",
      "enum": [
        "routine",
        "standard",
        "high",
        "destructive"
      ]
    },
    "base_sha": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[a-f0-9]{40,64}$"
    },
    "environment": {
      "type": [
        "string",
        "null"
      ]
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "wall_seconds",
        "subscription_stages",
        "repair_attempts"
      ],
      "properties": {
        "wall_seconds": {
          "type": "integer",
          "minimum": 60,
          "maximum": 5400
        },
        "subscription_stages": {
          "type": "integer",
          "minimum": 0,
          "maximum": 6
        },
        "repair_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2
        }
      }
    }
  }
}
