  "edge_guards_required": true,
  "any_running_state_can_record_cancellation_intent": true,
  "cloud_mutation_cancellation": "reconcile_before_new_execution",
  "mode_guards": {
    "delivery": {
      "learning_states_allowed": false,
      "preflight_next_by_kind": {
        "infra_plan": "PLAN_GENERATING",
        "infra_apply": "PLAN_GENERATING",
        "default": "CONTEXT"
      }
    },
    "portfolio": {
      "context_next": "LEARNING_PLAN",
      "implement_requires": [
        "owner_decision_current",
        "experiment_current",
        "owner_interpretation_current"
      ],
      "ready_for_pr_requires": [
        "owner_explanation_current",
        "portfolio_record_current",
        "technical_gates_passed"
      ],
      "apply_requires": [
        "learning_evidence_current",
        "technical_gates_passed",
        "approval_context_current"
      ],
      "waiting_does_not_call_models": true,
      "preflight_next": "CONTEXT",
      "after_owner_interpretation_by_kind": {
        "infra_plan": "PLAN_GENERATING",
        "infra_apply": "PLAN_GENERATING",
        "default": "IMPLEMENTING"
      },
      "plan_generating_requires": [
        "owner_decision_current",
        "experiment_current",
        "owner_interpretation_current"
      ],
      "waiting_approval_requires": [
        "owner_explanation_current",
        "portfolio_record_current",
        "technical_gates_passed"
      ],
      "portfolio_record_next_by_kind": {
        "infra_plan": "WAITING_APPROVAL",
        "infra_apply": "WAITING_APPROVAL",
        "default": "READY_FOR_PR"
      }
    }
  },
  "awaiting_approval_action_to_next_by_mode": {
    "accept_change": {
      "delivery": "READY_FOR_PR",
      "portfolio": "WAITING_OWNER_EXPLANATION"
    },
    "publish_draft_pr": {
      "delivery": "PUBLISHING",
      "portfolio": "PUBLISHING"
    },
    "apply_plan": {
      "delivery": "APPLYING",
      "portfolio": "APPLYING"
    }
  },
  "mode_change": {
    "owner_explicit_only": true,
    "safe_stop_first": true,
    "increment": [
      "spec_version",
      "mode_revision"
    ],
    "invalidate": [
      "approvals",
      "current_learning_completion"
    ],
    "preserve": [
      "raw_evidence",
      "budget_usage"
    ],
    "next": "PREFLIGHT"
  },
  "evidence_binding": {
    "raw_checkpoint_head_is_immutable": true,
    "final_manifest_binds_current_head": true,
    "semantic_change_requires_owner_amendment": true,
    "controller_revalidation_may_not_fabricate_owner_answers": true
  }
}
